# Porta usada pelo servidor local. A plataforma de deploy define PORT automaticamente.
PORT=3000

# Origens CORS permitidas, separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:5173,https://qalite-frontend.vercel.app

# Timeout das chamadas externas ao Slack, em milissegundos.
SLACK_REQUEST_TIMEOUT_MS=5000
