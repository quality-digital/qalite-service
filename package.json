{
  "name": "qalite-servidor",
  "version": "2.0.0",
  "description": "Proxy HTTP do QaLite-Servidor",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -w -p tsconfig.json",
    "lint": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "pretest": "npm run build",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "keywords": [
    "slack"
  ],
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@types/node": "^22.5.2",
    "husky": "^9.1.4",
    "lint-staged": "^16.2.7",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
